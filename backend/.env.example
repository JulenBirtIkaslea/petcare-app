APP_NAME=PetCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

# Mantener false hasta ejecutar el SQL manualmente y configurar PostgreSQL.
PETCARE_BD_HABILITADA=false
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestion_mascotas
DB_USERNAME=petcare
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:4200,localhost:4200,127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:4200
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=single
LOG_LEVEL=debug
MAIL_MAILER=log
MAIL_FROM_ADDRESS=petcare@example.test
MAIL_FROM_NAME=PetCare
BCRYPT_ROUNDS=12
